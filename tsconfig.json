{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.tsx",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "pages/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vite.pages.config.ts"
  ]
}